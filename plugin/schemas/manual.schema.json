{
  "$comment": "取扱説明書の中身。文章はすべて statements に置き、画面側は STM-ID で参照する",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company",
    "company_name",
    "as_of",
    "statements",
    "symptom_pages",
    "contacts",
    "routines",
    "devices",
    "glossary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "company_name": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updates": {
      "$comment": "完成後の更新の記録。target は直した相手、pages は更新の行を出すページ、kind は種類、summary は本人の答えの一言（60字まで）",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "pages", "by", "date"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "pages": { "type": "array", "items": { "type": "string", "pattern": "^T\\d+$" } },
          "by": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "kind": { "type": "string", "enum": ["contact", "page", "device", "add", "memo"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "symptom_exclusions": {
      "$comment": "聞き取りに困りごとの答えがあるが、Writer が理由を付けて手順ページにしなかったもの。後任向けの画面には出さない。pages は理由に書かれた受け皿のページで、普段の言い方の索引に足す",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "detail", "reason"],
        "properties": {
          "source": { "type": "string", "pattern": "^INT-\\d{3}$" },
          "detail": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "pages": { "type": "array", "items": { "type": "string", "pattern": "^T\\d+$" } }
        }
      }
    },
    "call_without_place": {
      "$comment": "業者に伝える文から機器の場所の行を外すページ。Verifier の指摘を受けてプログラムが入れる",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T\\d+$"
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(INV-\\d{3,5}|(INT|PUB|LIB)-\\d{3})$"
            }
          },
          "usage": {
            "$comment": "プログラムが組む文章の用途。社員に返す文に付け、Verifier が定型文を見分ける",
            "enum": [
              "reply_to_staff",
              "call_script",
              "pc_note"
            ]
          },
          "library": {
            "$comment": "部品の ID。文面はプログラムが組み立てる",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^LIB-\\d{3}$"
          }
        }
      }
    },
    "symptom_pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "title",
          "badge",
          "minutes",
          "reassurance",
          "notes",
          "first_steps",
          "first_goal",
          "branches",
          "steps",
          "goal",
          "exceptions",
          "info_rows",
          "fallback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "net",
              "print_scan",
              "file",
              "mail_teams",
              "pc",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          },
          "badge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "statement"
            ],
            "properties": {
              "value": {
                "enum": [
                  "self",
                  "check_first",
                  "vendor",
                  "internal"
                ]
              },
              "statement": {
                "type": "string",
                "pattern": "^STM-\\d{3}$"
              }
            }
          },
          "minutes": {
            "type": "integer",
            "minimum": 1
          },
          "reassurance": {
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          },
          "notes": {
            "$comment": "知っておく事実や禁止。番号もチェック欄も付かない",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STM-\\d{3}$"
            }
          },
          "reply_to_staff": {
            "$comment": "社員にそのまま返す文。プログラムが組む（plugin/lib/reply.mjs）。Writer は書かない",
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          },
          "first_steps": {
            "$comment": "① まずこれだけ。1分で済む操作だけ。最大3つ",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STM-\\d{3}$"
            }
          },
          "first_goal": {
            "$comment": "① で直ったと分かる状態",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^STM-\\d{3}$"
          },
          "branches": {
            "$comment": "② の前に読む条件",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STM-\\d{3}$"
            }
          },
          "steps": {
            "$comment": "② それでも直らなければ。人がやる操作だけで、1手順1文",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STM-\\d{3}$"
            }
          },
          "goal": {
            "$comment": "② で直ったと分かる状態",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^STM-\\d{3}$"
          },
          "exceptions": {
            "$comment": "② の途中で起こりうることと、止まり方",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STM-\\d{3}$"
            }
          },
          "info_rows": {
            "$comment": "この症状で使う会社の情報。決まった形の文章で、表示プログラムが文章から値を読む",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STM-\\d{3}$"
            }
          },
          "fallback": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "contact"
            ],
            "properties": {
              "contact": {
                "type": "string",
                "pattern": "^(VEN|INH)-\\d{2}$"
              },
              "message": {
                "$comment": "業者に伝える文。プログラムが組む（plugin/lib/reply.mjs）。Writer は書かない",
                "type": "string",
                "pattern": "^STM-\\d{3}$"
              }
            }
          }
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "phone",
          "role",
          "hours",
          "contract_location",
          "what_to_tell"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(VEN|INH)-\\d{2}$",
            "$comment": "VEN は業者、INH は社内の相談先"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "$comment": "社内の相談先で番号の記録がなければ空文字"
          },
          "role": {
            "type": "string",
            "pattern": "^STM-\\d{3}$",
            "$comment": "役割の短いラベル"
          },
          "hours": {
            "$comment": "受付の時間。社内の相談先で記録がなければ null",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^STM-\\d{3}$"
          },
          "contract_location": {
            "$comment": "契約番号の控えの場所。社内の相談先は null",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^STM-\\d{3}$"
          },
          "what_to_tell": {
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          }
        }
      }
    },
    "routines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "frequency",
          "title",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "frequency": {
            "enum": [
              "weekly",
              "monthly",
              "yearly"
            ]
          },
          "month": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STM-\\d{3}$"
            }
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "location",
          "purpose",
          "impact",
          "credential_location",
          "caution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          },
          "location": {
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          },
          "purpose": {
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          },
          "impact": {
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          },
          "credential_location": {
            "$comment": "パスワードの保管場所。値は書かない。なければ null",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^STM-\\d{3}$"
          },
          "caution": {
            "$comment": "やってはいけないこと。なければ null",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^STM-\\d{3}$"
          }
        }
      }
    },
    "glossary": {
      "$comment": "用語の説明。one_line と analogy は一般の説明で文字のまま、company は根拠を持つ文章の ID、help_page は困ったときに見る手順ページ",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "one_line",
          "analogy",
          "company"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "one_line": {
            "type": "string",
            "minLength": 1
          },
          "analogy": {
            "type": "string",
            "minLength": 1
          },
          "company": {
            "type": "string",
            "pattern": "^STM-\\d{3}$"
          },
          "help_page": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review": {
      "$comment": "前任者の確認。全ページの確認が済んだときだけプログラムが付ける。ないあいだは下書きとして表示する",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "confirmed_on"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "updated_by": {
          "$comment": "最新の更新を確認した人。角印に出す",
          "type": "string",
          "minLength": 1
        },
        "updated_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "confirmed_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "before_leaving": {
      "$comment": "退職する本人にしかできない作業の一覧。前任者の確認で本人に見せ、後任向けの取扱説明書には出さない",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^INT-\\d{3}$"
            }
          }
        }
      }
    },
    "search_index": {
      "$comment": "症状ごとの普段の言い方。画面の中で探すために HTML に入れる。検証の対象ではないのでプログラムで検査する",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "phrases"
        ],
        "properties": {
          "page": {
            "type": "string",
            "minLength": 1
          },
          "phrases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
