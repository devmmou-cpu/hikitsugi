{
  "$comment": "Interviewer の出力。次の1問、または聞き取りの終わり",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "gap", "covers", "question", "unfilled"],
  "properties": {
    "action": { "enum": ["ask", "finish"] },
    "gap": { "type": "string" },
    "covers": { "type": "array", "items": { "type": "string", "pattern": "^CHK-\\d{2}$" } },
    "question": { "type": "string" },
    "unfilled": {
      "$comment": "聞き直しの段階で、記録を読んでまだ埋まっていないと判断した必須項目。聞き直しの段階でなければ空の配列",
      "type": "array",
      "items": { "type": "string", "pattern": "^CHK-\\d{2}$" }
    }
  }
}
