{
  "$comment": "手順部品。PC の標準操作の文面で、本人が確認して承認したものだけを取扱説明書に出せる",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequences",
    "procedures"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "first",
          "first_goal",
          "branches",
          "steps",
          "goal",
          "exceptions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "first": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^LIB-\\d{3}$"
            }
          },
          "first_goal": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^LIB-\\d{3}$"
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^LIB-\\d{3}$"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^LIB-\\d{3}$"
            }
          },
          "goal": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^LIB-\\d{3}$"
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^LIB-\\d{3}$"
            }
          }
        }
      }
    },
    "procedures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "use_for",
          "text",
          "kinds",
          "needs_table",
          "status",
          "reviewed_by",
          "reviewed_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LIB-\\d{3}$"
          },
          "use_for": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "approved",
              "unapproved"
            ]
          },
          "reviewed_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_on": {
            "type": [
              "string",
              "null"
            ]
          },
          "kinds": {
            "$comment": "置いてよいページの項目",
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "first_steps",
                "first_goal",
                "branches",
                "steps",
                "goal",
                "exceptions"
              ]
            }
          },
          "needs_table": {
            "$comment": "会社の情報の表を指す部品",
            "type": "boolean"
          }
        }
      }
    }
  }
}
