{
  "$comment": "T1〜T5 の正しい行動。self は自力で解決、contact は連絡先への連絡",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "company", "troubles"],
  "properties": {
    "schema_version": { "const": 1 },
    "company": { "type": "string", "minLength": 1 },
    "troubles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "symptom", "action", "contact", "support"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[1-5]$" },
          "symptom": { "type": "string", "minLength": 1 },
          "action": { "enum": ["self", "contact"] },
          "contact": { "type": ["string", "null"], "pattern": "^VEN-\\d{2}$" },
          "support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "contains"],
              "properties": {
                "ref": { "type": "string", "pattern": "^(INV|INT)-\\d{3}$" },
                "contains": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
