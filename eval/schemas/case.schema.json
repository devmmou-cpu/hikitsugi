{
  "$comment": "評価セットの概要。基準日を固定し、結果が実行時刻に左右されないようにする",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "company", "name", "fictional", "as_of", "summary", "vendors", "split"],
  "properties": {
    "schema_version": { "const": 1 },
    "company": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "fictional": { "const": true },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "summary": { "type": "string", "minLength": 1 },
    "split": { "enum": ["tuning", "holdout"] },
    "vendors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "phone", "hours"],
        "properties": {
          "id": { "type": "string", "pattern": "^VEN-\\d{2}$" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "phone": { "type": "string", "pattern": "^03-0000-01\\d{2}$" },
          "hours": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
